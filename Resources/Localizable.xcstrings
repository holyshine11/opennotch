{
  "sourceLanguage": "en",
  "strings": {
    "%@ menu bar › View › Developer › click “Allow JavaScript from Apple Events” so it shows a check mark": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴 막대 › 보기 › 개발자 › “Apple Events의 자바스크립트 허용”을 눌러 체크 표시가 보이게 하기"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %@"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "About OpenNotch": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch 정보"
          }
        }
      }
    },
    "AirDrop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop"
          }
        }
      }
    },
    "AirDrop is unavailable. Turn on Wi‑Fi and Bluetooth.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 사용할 수 없습니다. Wi‑Fi와 Bluetooth를 켜 주세요."
          }
        }
      }
    },
    "Allow OpenNotch to control %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch가 %@을(를) 제어하도록 허용해 주세요"
          }
        }
      }
    },
    "Allow OpenNotch to control the browser": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch가 브라우저를 제어하도록 허용"
          }
        }
      }
    },
    "Allow OpenNotch to read the clipboard in System Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 OpenNotch의 클립보드 읽기를 허용해 주세요"
          }
        }
      }
    },
    "Allow in System Settings…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 허용…"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Check: open a YouTube or YouTube Music tab — the row above turns green as soon as the setting is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 방법: YouTube 또는 YouTube Music 탭을 열어 두면, 설정이 켜지는 즉시 위 줄이 초록색 체크로 바뀝니다."
          }
        }
      }
    },
    "Clear history": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 지우기"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드"
          }
        }
      }
    },
    "Control YouTube in your browser": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저의 YouTube 제어"
          }
        }
      }
    },
    "Controls need “Allow JavaScript from Apple Events”": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어하려면 “Apple Events의 자바스크립트 허용”이 필요합니다"
          }
        }
      }
    },
    "Controls need “Allow JavaScript from Apple Events” in the browser. The guide shows where it is and whether it’s on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어하려면 브라우저에서 “Apple Events의 자바스크립트 허용”이 필요합니다. 안내 창에서 위치와 현재 켜짐 여부를 볼 수 있습니다."
          }
        }
      }
    },
    "Copy something to see it here": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하면 여기에 표시됩니다"
          }
        }
      }
    },
    "Could not change login item": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경할 수 없습니다"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제"
          }
