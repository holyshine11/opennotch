{
  "sourceLanguage": "en",
  "strings": {
    "%@ menu bar › View › Developer › click “Allow JavaScript from Apple Events” so it shows a check mark": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴 막대 › 보기 › 개발자 › “Apple Events의 자바스크립트 허용”을 눌러 체크 표시가 보이게 하기"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %@"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "About OpenNotch": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch 정보"
          }
        }
      }
    },
    "AirDrop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop"
          }
        }
      }
    },
    "AirDrop is unavailable. Turn on Wi‑Fi and Bluetooth.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 사용할 수 없습니다. Wi‑Fi와 Bluetooth를 켜 주세요."
          }
        }
      }
    },
    "All set — every browser is ready.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 — 모든 브라우저를 제어할 수 있습니다."
          }
        }
      }
    },
    "Allow JavaScript from Apple Events": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events의 자바스크립트 허용"
          }
        }
      }
    },
    "Allow JavaScript from Apple Events (Safari)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow JavaScript from Apple Events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 이벤트에서 JavaScript 허용"
          }
        }
      }
    },
    "Allow OpenNotch to control %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch가 %@을(를) 제어하도록 허용해 주세요"
          }
        }
      }
    },
    "Allow OpenNotch to read the clipboard in System Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 OpenNotch의 클립보드 읽기를 허용해 주세요"
          }
        }
      }
    },
    "Allow in System Settings…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 허용…"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "Apple Music works right away. Browsers need a one-time setting — the guide shows where.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music은 바로 됩니다. 브라우저는 설정 하나가 필요합니다 — 안내에서 위치를 보여 줍니다."
          }
        }
      }
    },
    "Apple Music works right away. Each browser needs one setting turned on — about a minute.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music은 바로 됩니다. 브라우저는 설정 하나만 켜면 됩니다 — 1분이면 충분합니다."
          }
        }
      }
    },
    "Apple Music works right away. No supported browser is installed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music은 바로 됩니다. 지원하는 브라우저는 설치되어 있지 않습니다."
          }
        }
      }
    },
    "Blocked in System Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 차단됨"
          }
        }
      }
    },
    "Browsers need a one-time setting — about a minute.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저는 설정 하나만 켜면 됩니다 — 1분이면 충분합니다."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Clear history": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 지우기"
          }
        }
      }
    },
    "Click the notch or press ⌃⌥N to open the panel.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 클릭하거나 ⌃⌥N을 누르면 패널이 열립니다."
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드"
          }
        }
      }
    },
    "Control YouTube, Spotify web and Apple Music from here": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 YouTube·Spotify 웹·Apple Music을 제어하세요"
          }
        }
      }
    },
    "Control YouTube, Spotify web, and Apple Music": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube·Spotify 웹·Apple Music 제어"
          }
        }
      }
    },
    "Copy something to see it here": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하면 여기에 표시됩니다"
          }
        }
      }
    },
    "Could not change login item": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경할 수 없습니다"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제"
          }
        }
      }
    },
