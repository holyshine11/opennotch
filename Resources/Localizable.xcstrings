      }
    },
    "Done": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Drag files onto the notch to AirDrop them or keep them in the shelf.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 노치로 끌어오면 AirDrop으로 보내거나 셸프에 보관할 수 있습니다."
          }
        }
      }
    },
    "Drop files here": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 여기에 놓으세요"
          }
        }
      }
    },
