      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 보기"
          }
        }
      }
    },
    "Safari menu › Settings… (⌘,) › Advanced tab › turn on “Show features for web developers” at the bottom": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 메뉴 › 설정… (⌘,) › 고급 탭 › 맨 아래 “웹 개발자를 위한 기능 보기” 켜기"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색"
          }
        }
      }
    },
    "Set up YouTube controls": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 제어 설정하기"
          }
        }
      }
    },
    "Setting is off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 꺼져 있음"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
