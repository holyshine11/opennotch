{
  "sourceLanguage": "en",
  "strings": {
    "%@ menu bar › View › Developer › click “Allow JavaScript from Apple Events” so it shows a check mark": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴 막대 › 보기 › 개발자 › “Apple Events의 자바스크립트 허용”을 눌러 체크 표시가 보이게 하기"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %@"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "About OpenNotch": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch 정보"
          }
        }
      }
    },
    "AirDrop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop"
          }
        }
      }
    },
    "AirDrop is unavailable. Turn on Wi‑Fi and Bluetooth.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 사용할 수 없습니다. Wi‑Fi와 Bluetooth를 켜 주세요."
          }
        }
      }
    },
    "Allow JavaScript from Apple Events": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events의 자바스크립트 허용"
          }
        }
      }
    },
    "Allow JavaScript from Apple Events (Safari)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow JavaScript from Apple Events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 이벤트에서 JavaScript 허용"
          }
        }
      }
    },
    "Allow OpenNotch to control %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch가 %@을(를) 제어하도록 허용해 주세요"
          }
        }
      }
    },
    "Allow OpenNotch to read the clipboard in System Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 OpenNotch의 클립보드 읽기를 허용해 주세요"
          }
        }
      }
    },
    "Allow control in macOS": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 제어 허용"
