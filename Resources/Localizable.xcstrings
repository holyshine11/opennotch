      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch"
          }
        }
      }
    },
    "Play something in Apple Music, or open YouTube or Spotify in your browser": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music에서 재생하거나, 브라우저에서 YouTube 또는 Spotify를 열어 주세요"
          }
        }
      }
    },
    "Press the button next to a browser to open YouTube in it. If macOS asks to allow control, click Allow. Then turn on the menu item shown under that browser — the check turns green by itself.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 옆 버튼을 누르면 그 브라우저에서 YouTube가 열립니다. macOS가 제어를 허용할지 물어보면 ‘허용’을 누르세요. 그다음 브라우저 아래 표시된 메뉴 항목을 켜면 체크가 저절로 초록색이 됩니다."
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 처리방침"
          }
        }
      }
    },
