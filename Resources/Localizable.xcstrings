    "Safari › Settings › Developer › Allow JavaScript from Apple Events (turn on Settings › Advanced › Show features for web developers first; only once)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari › 설정 › 개발자 › Apple Events의 JavaScript 허용 (먼저 설정 › 고급 › 웹 개발자용 기능 표시를 켜세요. 한 번만 하면 됩니다)"
          }
        }
      }
    },
