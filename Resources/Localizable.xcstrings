{
  "sourceLanguage": "en",
  "strings": {
    "%@ menu bar › View › Developer › Allow JavaScript from Apple Events (only once)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴 막대 › 보기 › 개발자 › Apple Events의 자바스크립트 허용 (한 번만 켜면 됩니다)"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "About OpenNotch": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch 정보"
          }
        }
      }
    },
    "AirDrop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop"
          }
        }
      }
    },
    "AirDrop is unavailable. Turn on Wi‑Fi and Bluetooth.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 사용할 수 없습니다. Wi‑Fi와 Bluetooth를 켜 주세요."
          }
        }
      }
    },
    "Allow OpenNotch to control %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenNotch가 %@을(를) 제어하도록 허용해 주세요"
          }
        }
      }
    },
    "Allow OpenNotch to read the clipboard in System Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 OpenNotch의 클립보드 읽기를 허용해 주세요"
          }
        }
      }
    },
    "Allow in System Settings…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 허용…"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Clear history": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 지우기"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드"
          }
        }
      }
    },
    "Control YouTube in your browser": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저의 YouTube 제어"
          }
        }
      }
    },
    "Controls need “Allow JavaScript from Apple Events”": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어하려면 “Apple Events의 자바스크립트 허용”이 필요합니다"
          }
        }
      }
    },
    "Controls need “Allow JavaScript from Apple Events” in the browser’s View › Developer menu. Without it only the tab title is shown.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어하려면 브라우저의 보기 › 개발자 메뉴에서 “Apple Events의 자바스크립트 허용”을 켜야 합니다. 켜지 않으면 탭 제목만 표시됩니다."
          }
        }
      }
    },
    "Copy something to see it here": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하면 여기에 표시됩니다"
          }
        }
      }
    },
    "Could not change login item": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경할 수 없습니다"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제"
