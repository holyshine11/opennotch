    },
    "Whale menu bar › View › Developer info › Allow JavaScript from Apple Events (only once)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whale 메뉴 막대 › 보기 › 개발자 정보 › Apple Events의 자바스크립트 허용 (한 번만 켜면 됩니다)"
